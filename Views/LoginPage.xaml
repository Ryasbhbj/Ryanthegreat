<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
xmlns:viewmodels="clr-namespace:YourMauiApp.ViewModels"
x:Class="YourMauiApp.Views.LoginPage"
Title="Login">
<ContentPage.BindingContext>
<viewmodels:LoginViewModel />
</ContentPage.BindingContext>


<ScrollView>
<VerticalStackLayout Spacing="12" Padding="24">
<Label Text="Welcome back" FontSize="24" />


<Entry Text="{Binding Email}" Placeholder="Email" Keyboard="Email" />
<Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True" />


<Button Text="Sign in" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
<Button Text="Continue with Google" Command="{Binding GoogleCommand}" />


<Button Text="Forgot password" Command="{Binding ForgotCommand}" />
</VerticalStackLayout>
</ScrollView>
</ContentPage>