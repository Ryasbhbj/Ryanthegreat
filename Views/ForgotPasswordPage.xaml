<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
xmlns:viewmodels="clr-namespace:YourMauiApp.ViewModels"
x:Class="YourMauiApp.Views.ForgotPasswordPage"
Title="Forgot password">
<ContentPage.BindingContext>
<viewmodels:ForgotPasswordViewModel />
</ContentPage.BindingContext>


<VerticalStackLayout Spacing="12" Padding="24">
<Label Text="Reset your password" FontSize="24" />
<Entry Text="{Binding Email}" Placeholder="Your account email" Keyboard="Email" />
<Button Text="Send reset link" Command="{Binding SubmitCommand}" />
</VerticalStackLayout>
</ContentPage>